{
  "name": "electrozen-pos",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "author": "ELECTROZEN",
  "description": "ELECTROZEN — Appliances & Electronics Store Management System (Windows Desktop App + Android Wi-Fi Server + WooCommerce Sync)",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "server": "node --use-system-ca server/index.ts",
    "dev": "node --use-system-ca --watch server/index.ts",
    "electron": "electron .",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "ma.electrozen.desktop",
    "productName": "ELECTROZEN",
    "directories": {
      "output": "D:/electrozen_dist",
      "buildResources": "build-resources"
    },
    "files": [
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "server",
        "to": "app-runtime/server"
      },
      {
        "from": "public",
        "to": "app-runtime/public"
      },
      {
        "from": "build-resources/node-bin",
        "to": "node-bin"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build-resources/icon.png",
      "artifactName": "ELECTROZEN-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ELECTROZEN"
    }
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.18.0"
  }
}
